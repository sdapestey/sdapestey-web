# Ejemplo de vhost nginx para sdapestey.com.ar
# Copiar/adaptar en /etc/nginx/sites-available/ (o el conf que ya uses).
#
# Si ya tenés un proxy_pass a 127.0.0.1:8080 (Docker nginx viejo),
# alcanza con dejar lighttpd en ese puerto — no hace falta tocar TLS.

server {
    listen 80;
    listen [::]:80;
    server_name sdapestey.com.ar www.sdapestey.com.ar;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sdapestey.com.ar www.sdapestey.com.ar;

    # Ajustá rutas de certificados a las tuyas (certbot)
    ssl_certificate     /etc/letsencrypt/live/sdapestey.com.ar/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sdapestey.com.ar/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
