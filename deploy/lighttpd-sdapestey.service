[Unit]
Description=lighttpd portfolio sdapestey.com.ar
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sdapestey/sdapestey-web
ExecStart=/usr/sbin/lighttpd -D -f /home/sdapestey/sdapestey-web/lighttpd.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
